{
  "name": "cardmates",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "test": "jest",
    "start": "expo start",
    "start:bypass": "node ./scripts/start-app.js",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "build:preview": "eas build --profile preview --platform all",
    "build:production": "eas build --profile production --platform all",
    "build:ios": "eas build --profile production --platform ios",
    "build:android": "eas build --profile production --platform android",
    "deploy": "node scripts/deploy.js",
    "deploy:ios": "node scripts/deploy.js ios production",
    "deploy:android": "node scripts/deploy.js android production",
    "deploy:preview": "node scripts/deploy.js all preview",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "optimize": "npx expo export:clear && npm run prebuild:clean",
    "check-deps": "npx expo doctor",
    "verify-fixes": "echo 'Fixed: 1. Firestore transaction errors 2. Live rarity updates 3. Duplicate auction completion'"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.3.1",
    "@expo/metro-config": "0.20.0",
    "@expo/server": "^0.6.2",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^1.3.21",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@stripe/stripe-react-native": "0.45.0",
    "@types/react": "~19.0.10",
    "expo": "^53.0.11",
    "expo-av": "~15.1.5",
    "expo-blur": "~14.1.5",
    "expo-camera": "~16.1.7",
    "expo-constants": "~17.1.6",
    "expo-crypto": "~14.1.5",
    "expo-device": "^7.1.4",
    "expo-file-system": "^18.1.10",
    "expo-font": "~13.3.1",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.2.0",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.4",
    "expo-media-library": "~17.1.7",
    "expo-notifications": "~0.31.3",
    "expo-router": "^5.0.6",
    "expo-secure-store": "~14.2.3",
    "expo-splash-screen": "~0.30.9",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.8",
    "expo-updates": "~0.28.14",
    "expo-web-browser": "~14.1.6",
    "firebase": "^10.14.1",
    "firebase-admin": "^13.3.0",
    "idb": "^7.1.1",
    "lottie-react-native": "^7.2.2",
    "metro": "0.82.0",
    "metro-config": "0.82.0",
    "metro-core": "0.82.0",
    "metro-resolver": "0.82.0",
    "metro-runtime": "0.82.0",
    "metro-source-map": "0.76.8",
    "object-hash": "^3.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.3",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-paper": "^5.12.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-sound": "^0.11.2",
    "react-native-svg": "15.11.2",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "^0.20.0",
    "react-native-webview": "13.13.5",
    "typescript": "^5.3.0",
    "undici": "^7.8.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-transform-export-namespace-from": "^7.24.1",
    "@babel/plugin-transform-react-jsx": "^7.27.1",
    "@babel/plugin-transform-runtime": "^7.27.1",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@expo/config-plugins": "~10.0.0",
    "@expo/prebuild-config": "~9.0.0",
    "@react-native-community/cli": "latest",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.2.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "body-parser": "^2.2.0",
    "chokidar": "^4.0.3",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "eas-cli": "^16.9.0",
    "eslint": "^8.56.0",
    "eslint-config-expo": "~9.2.0",
    "express": "^5.1.0",
    "jest": "^29.7.0",
    "metro-react-native-babel-transformer": "^0.77.0",
    "stripe": "^18.1.0"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "react-native-fs"
        ]
      },
      "nativeModulesVersionsCheck": {
        "excluded": [
          "@expo/config-plugins",
          "@expo/prebuild-config"
        ]
      }
    },
    "install": {
      "exclude": [
        "@expo/config-plugins",
        "@expo/prebuild-config"
      ]
    }
  }
}
